# Public documentation examples only; replace these before enabling the feature.
LIBKI_VIEWER_ENABLED=false
LIBKI_VIEWER_ORIGIN=https://libki.example.org
# Empty selects Libki default instance; use the exact name for a named instance.
LIBKI_VIEWER_INSTANCE=
LIBKI_VIEWER_CLIENT_NAME=DEMO-PC-01
LIBKI_VIEWER_HMAC_FILE=/run/secrets/libki_viewer_hmac
LIBKI_VIEWER_PASSWORD_FILE=/run/secrets/libki_viewer_password
# Gateway only: documentation IPv4 address; not a real workstation.
LIBKI_VIEWER_TARGET_HOST=192.0.2.10
LIBKI_VIEWER_TARGET_PORT=5901
LIBKI_VIEWER_NONCE_DIR=/var/lib/libki-viewer/nonces
